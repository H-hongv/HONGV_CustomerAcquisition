# 获客自动化系统 - 环境变量配置
# 复制此文件为 .env 并填入你的API Key

# ============ 搜索API ============
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ============ LLM API ============
# 选择一个即可, 也可以在UI界面配置
MIMO_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============ 日志 ============
LOG_LEVEL=INFO


# === Additional APIs ===
SERPAPI_API_KEY=
APIFY_API_KEY=
HUNTERIO_API_KEY=
GROQ_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
ZEROBOUNCE_API_KEY=
PROSPECTOR_API_KEY=
# === Gmail SMTP (App Password) ===
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
